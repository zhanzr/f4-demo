/*
 * WiFi credentials for the wifi_http_server app - TEMPLATE (commit this one).
 *
 * Copy this file to wifi_config.h and fill in your own AP name / password.
 * wifi_config.h is ignored by git (the repo .gitignore excludes any file
 * named wifi_config.h), so credentials are never pushed to the remote repo.
 *
 *     cp wifi_config.h.example wifi_config.h
 */
#ifndef WIFI_CONFIG_H
#define WIFI_CONFIG_H

#define AP_SSID   "your_ap_name"
#define AP_PASS   "your_password"

#endif /* WIFI_CONFIG_H */